---
import { Image } from 'astro:assets';
import placeholderIcon from '../assets/placeholder-icon.svg';

interface Props {
  appUrl: string;
}

const { appUrl } = Astro.props;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand">
      <Image
        src={placeholderIcon}
        alt="Task Time Tracker アイコン"
        width={32}
        height={32}
        class="site-header__icon"
      />
      <span class="site-header__name">Task Time Tracker</span>
    </a>
    <a href={appUrl} class="btn-primary site-header__cta">使ってみる</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-surface-muted);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.75rem;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-text);
    min-width: 0;
  }

  .site-header__icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
  }

  .site-header__name {
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .site-header__cta {
    flex-shrink: 0;
    font-size: 0.875rem;
    padding: 0.5rem 1.25rem;
  }

  @media (min-width: 768px) {
    .site-header__name {
      font-size: 1rem;
    }

    .site-header__cta {
      font-size: 1rem;
      padding: 0.625rem 1.75rem;
    }
  }
</style>
