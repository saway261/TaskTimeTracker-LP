---
import { Image } from 'astro:assets';
import timerSvg from '../assets/value/timer.svg';
import searchSvg from '../assets/value/search.svg';
import graphSvg from '../assets/value/graph.svg';
import glitterSvg from '../assets/value/glitter.svg';

interface Props {
  appUrl: string;
}

const { appUrl } = Astro.props;

const values = [
  {
    icon: timerSvg,
    text: 'Task Time Tracker は、タスクを「見積時間」と「実績時間」のセットで管理します。',
  },
  {
    icon: searchSvg,
    text: 'さらに、振り返り機能でタスクの実績時間が見積時間より超過あるいは短縮した際の原因を保存します。',
  },
  {
    icon: graphSvg,
    text: '見積と実績の誤差を継続的に記録・内省することで己と向き合う作業をアシストします。',
  },
  {
    icon: glitterSvg,
    text: 'あなたの見積もりのクセを明らかにし、見積もり精度の改善に役立ててください！',
  },
];
---

<section class="value">
  <div class="container">
    <ul class="value__list">
      {values.map((item) => (
        <li class="value__item">
          <span class="value__icon" aria-hidden="true">
            <Image src={item.icon} alt="" width={44} height={44} class="value__icon-image" />
          </span>
          <p class="value__text">{item.text}</p>
        </li>
      ))}
    </ul>
    <div class="value__cta">
      <a href={appUrl} class="btn-primary">使ってみる</a>
    </div>
  </div>
</section>

<style>
  .value {
    padding: 4rem 1rem;
    background-color: var(--color-surface);
  }

  .value__list {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .value__item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background-color: var(--color-bg);
    border-radius: 8px;
    border-left: 4px solid var(--color-accent);
  }

  .value__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .value__icon-image {
    display: block;
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .value__text {
    margin: 0;
    color: var(--color-text);
    line-height: 1.7;
  }

  .value__cta {
    text-align: center;
  }

  @media (min-width: 768px) {
    .value__list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
